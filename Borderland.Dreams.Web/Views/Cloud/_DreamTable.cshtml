@model Borderland.Dreams.ViewModels.DreamFilterViewModel

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Dreams[0].Name)</th>
            <th>@Html.DisplayNameFor(model => model.Dreams[0].CreatedAt)</th>
            <th>@Html.DisplayNameFor(model => model.Dreams[0].Status)</th>
            <th>@Html.DisplayNameFor(model => model.Dreams[0].RequestedBudgetItems) (min)</th>
            <th>@Html.DisplayNameFor(model => model.Dreams[0].TotalReceivedFunds)</th>
            <th>By dreamer</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Dreams)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.CreatedAt)</td>
                <td>@Html.DisplayFor(modelItem => item.Status)</td>
                <td>@Html.DisplayFor(modelItem => item.TotalRequestedBudget)</td>
                <td>@Html.DisplayFor(modelItem => item.TotalReceivedFunds)</td>
                <td>@Html.DisplayFor(modelItem => item.Dreamers.Single(d => d.IsMainDreamer).Name)</td>
                <td>
                    <a asp-controller="Dream" asp-action="Details" asp-route-id="@item.ID">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>