@model Borderland.Dreams.ViewModels.JoinCloudOrCreateDreamViewModel

<p>
@if (Model.ShowJoinCloudButton)
{
    <form asp-action="Join" asp-controller="Cloud" method="post">
        <input type="hidden" name="id" value="@Model.CloudId" />
        <button type="submit">Join Cloud</button>
    </form>
}
else if (Model.IsDreamingPeriodActive)
{
    <a asp-controller="Dream" asp-action="Create" class="btn btn-primary">Create New Dream</a>
}
else
{
    @if (User.IsInRole(Constants.AdminRole))
    {
        <a asp-controller="Dream" asp-action="Create" class="btn btn-primary">Create New Dream</a>
        <text>(Dreaming period isn't active, but admins can see the button anyway)</text>
    }
}
</p>