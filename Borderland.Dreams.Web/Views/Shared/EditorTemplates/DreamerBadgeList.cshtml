@model List<Borderland.Dreams.ViewModels.DreamerViewModel>

<ul class="list-unstyled">
    @foreach (var dreamer in Model)
    {
        <li>
            <span class="badge bg-@(dreamer.IsMainDreamer ? "primary" : "secondary")" title="@(dreamer.IsMainDreamer ? "Main Dreamer" : "Co-Dreamer")">
                @Html.DisplayFor(model => dreamer.Name)
            </span>
        </li>
    }
</ul>