@model Borderland.Dreams.ViewModels.DreamViewModel

@{
    ViewData["Title"] = "Cancel Dream";
}

<div class="row">
    <div class="col-md-6">
        <h1>Are you sure you want to cancel this dream?</h1>
    </div>
    <div class="col-md-6 text-end mt-2">
        <button type="submit" class="btn btn-danger" form="form-cancel-dream">Cancel dream</button>
        <a class="btn btn-secondary" asp-action="Details" asp-route-id="@Model.ID">Go back</a>
    </div>
</div>

<div class="alert alert-warning" role="alert">
    Funds received by this dream will be treated as spent on unforeseen expenses.
    They will not be returned to the cloud's shared funding pot, and users who funded this dream
    will not receive the money back in their wallets.
</div>

<form asp-action="Cancel" id="form-cancel-dream">
    <input type="hidden" asp-for="ID" />
</form>

<hr />
<dl class="row">
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.Name)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.Name)
    </dd>
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.Status)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.Status)
    </dd>
</dl>
