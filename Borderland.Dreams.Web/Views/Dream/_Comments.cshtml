@model IReadOnlyList<Borderland.Dreams.ViewModels.CommentViewModel>

@if (Model.Count == 0)
{
    <p>No comments yet.</p>
}
else
{
    <ul class="list-unstyled">
        @foreach (var comment in Model)
        {
            @await Html.PartialAsync("_CommentThreadItem", comment)
        }
    </ul>
}
