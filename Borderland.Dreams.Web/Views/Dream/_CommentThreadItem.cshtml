@model Borderland.Dreams.ViewModels.CommentViewModel

<li id="comment-@Model.Id" class="border-bottom py-3">
    <p class="mb-1">
        <strong>@Model.AuthorName</strong>
        <time>@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</time>
    </p>
    <div class="comment-body">@Model.Body</div>

    @if (ViewBag.CanComment == true)
    {
        var replyForm = Model.ReplyForm ?? new Borderland.Dreams.ViewModels.CommentPostViewModel
        {
            DreamId = Model.DreamId,
            ParentCommentId = Model.Id
        };
        var isReplyFormOpen = Model.ReplyForm != null;
        var replyFormContainerId = $"reply-form-container-{Model.Id}";
        <button type="button"
                class="btn btn-link p-0 reply-toggle"
                aria-expanded="@(isReplyFormOpen ? "true" : "false")"
                aria-controls="@replyFormContainerId">Reply</button>
        <div id="@replyFormContainerId" hidden="@(isReplyFormOpen ? null : "hidden")">
            @await Html.PartialAsync("_ReplyForm", replyForm)
        </div>
    }

    @if (Model.Replies.Count > 0)
    {
        <ul class="list-unstyled ms-4 border-start ps-3">
            @foreach (var reply in Model.Replies)
            {
                @await Html.PartialAsync("_CommentThreadItem", reply)
            }
        </ul>
    }
</li>
