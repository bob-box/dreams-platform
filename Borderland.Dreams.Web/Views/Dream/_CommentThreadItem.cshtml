@using Borderland.Dreams.Authorization
@model Borderland.Dreams.ViewModels.CommentViewModel

@{
    var currentUserId = ViewBag.CurrentUserId as string;
    var isAuthor = currentUserId != null && Model.AuthorId == currentUserId;
    var canComment = ViewBag.CanComment == true;
}

<li id="comment-@Model.Id" class="border-bottom py-3">
    @if (Model.IsDeleted)
    {
        <p class="mb-1 text-muted">[deleted]</p>
    }
    else
    {
        <p class="mb-1">
            <strong>@Model.AuthorName</strong>
            <time>@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</time>
            @if (Model.EditedAt.HasValue)
            {
                <span class="text-muted small">(edited @Model.EditedAt)</span>
            }
        </p>
        <div class="comment-body">@Model.Body</div>

        @if (canComment && isAuthor)
        {
            var editForm = Model.EditForm ?? new Borderland.Dreams.ViewModels.CommentPostViewModel
            {
                DreamId = Model.DreamId,
                CommentId = Model.Id,
                Body = Model.Body
            };
            var isEditFormOpen = Model.EditForm != null;
            var editFormContainerId = $"edit-form-container-{Model.Id}";
            <button type="button"
                    class="btn btn-link p-0 edit-toggle"
                    aria-expanded="@(isEditFormOpen ? "true" : "false")"
                    aria-controls="@editFormContainerId">Edit</button>
            <div id="@editFormContainerId" data-comment-form-container hidden="@(isEditFormOpen ? null : "hidden")">
                @await Html.PartialAsync("_CommentEditForm", editForm)
            </div>
        }

        @if (canComment && Model.IsReplyAllowed)
        {
            var replyForm = Model.ReplyForm ?? new Borderland.Dreams.ViewModels.CommentPostViewModel
            {
                DreamId = Model.DreamId,
                ParentCommentId = Model.Id
            };
            var isReplyFormOpen = Model.ReplyForm != null;
            var replyFormContainerId = $"reply-form-container-{Model.Id}";
            <button type="button"
                    class="btn btn-link p-0 reply-toggle"
                    aria-expanded="@(isReplyFormOpen ? "true" : "false")"
                    aria-controls="@replyFormContainerId">Reply</button>
            <div id="@replyFormContainerId" data-comment-form-container hidden="@(isReplyFormOpen ? null : "hidden")">
                @await Html.PartialAsync("_ReplyForm", replyForm)
            </div>
        }

        @if (isAuthor || User.IsInRole(Constants.AdminRole))
        {
            <form asp-controller="Comment" asp-action="Delete" method="post" class="d-inline"
                  onsubmit="return confirm('Are you sure you want to delete this comment?');">
                <input type="hidden" name="dreamId" value="@Model.DreamId" />
                <input type="hidden" name="commentId" value="@Model.Id" />
                <button type="submit" class="btn btn-link p-0 text-danger">Delete</button>
            </form>
        }
    }

    @if (Model.Replies.Count > 0)
    {
        <ul class="list-unstyled ms-4 border-start ps-3">
            @foreach (var reply in Model.Replies)
            {
                @await Html.PartialAsync("_CommentThreadItem", reply)
            }
        </ul>
    }
</li>
