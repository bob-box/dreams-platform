@model IEnumerable<Borderland.Dreams.ViewModels.UserViewModel>
@{
    ViewData["Title"] = "Manage Users";
}

<h1>@ViewBag.Title</h1>

<div class="position-fixed top-0 start-50 translate-middle-x pt-3" style="z-index: 1080;">
    <div id="users-status-toast" class="toast" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="true" data-bs-delay="4000">
        <div id="users-status-toast-body" class="toast-body bg-opacity-25">
        </div>
    </div>
</div>

<div class="row">
    <div class="col-9">
        <form id="users-search-form" method="get" class="mb-3">
            <div class="input-group">
                <input id="users-search-input" type="search" name="q" class="form-control" placeholder="Search by name or email" />
                <button id="users-search-submit" class="btn btn-outline-secondary" type="submit">Search</button>
                <button id="users-search-clear" style="display:none;" class="btn btn-danger" type="reset">Clear</button>
            </div>
        </form>
    </div>
    <div class="col-3 text-end">
        <button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#update-wallet-modal">Update all wallets</button>
    </div>
</div>

<table id="usersTable" class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th colspan="2">Wallet Balance</th>
        </tr>
    </thead>

    <partial name="~/Areas/Admin/Views/Users/_ManageUsersTable.cshtml" model="Model" />

</table>
<partial name="~/Areas/Admin/Views/Users/_UpdateWalletModal.cshtml" />


@section Scripts {
    <script>
        const searchForm = document.getElementById('users-search-form');
        const inputField = document.getElementById('users-search-input');
        const oldTbody = document.querySelector('#usersTable tbody');
        const clearButton = document.getElementById('users-search-clear');
        const updateWalletForm = document.getElementById('update-wallet-form');
        const updateModal = document.getElementById('update-wallet-modal');
        const updateRoleForm = document.getElementById('update-role-form');
        const usersStatusToastElement = document.getElementById('users-status-toast');
        const usersStatusToastBody = document.getElementById('users-status-toast-body');
        const usersStatusToast = bootstrap.Toast.getOrCreateInstance(usersStatusToastElement);

        function showStatusMessage(message, statusClass) {
            usersStatusToastBody.classList.add(`bg-${statusClass}`, `border`, `border-${statusClass}`);
            usersStatusToastBody.textContent = message;
            usersStatusToast.show();
        }

        async function fetchResults(filter) {
            const url = '@Url.Action("Filter", "Users", new { area = "Admin" })' + (filter ? '?filter=' + encodeURIComponent(filter) : '');
            const res = await fetch(url);
            if (!res.ok) return;
            const html = await res.text();
            oldTbody.innerHTML = html;
        }

        function toggleClearButton() {
            clearButton.style.display = inputField.value.trim() ? '' : 'none';
        }

        inputField.addEventListener('input', function(e){
            // if field is empty, hide clear button
            toggleClearButton();
        });

        searchForm.addEventListener('submit', function (e) {
            e.preventDefault();
            fetchResults(inputField.value);
            toggleClearButton();
        });

        clearButton.addEventListener('click', function (e) {
            fetchResults('');
            toggleClearButton();
        });

        updateRoleForm.addEventListener('submit', async function (e) {
            e.preventDefault();
            const form = e.target;
            const submitButton = form.querySelector('button[type="submit"]');
            submitButton.disabled = true;

            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                });

                const data = await response.json();
                showStatusMessage(data.message ?? 'Role update failed.', data.statusClass ?? 'danger');
            } catch {
                showStatusMessage('Role update failed.', 'danger');
            } finally {
                submitButton.disabled = false;
            }
        });

        $("#update-wallet-modal").on("hidden.bs.modal", function () {
            $("#update-wallet-modal form")[0].reset();
        });

        updateWalletForm.addEventListener('submit', function (e) {
            let action = [...document.getElementsByName("action")].filter(x => x.checked)[0]?.value;
            if (!action) {
                e.preventDefault();
                document.getElementById("modal-action-validation").innerText = "You must choose an update action.";
            }
        });

        updateModal.addEventListener('shown.bs.modal', function (event) {
            document.getElementById("modal-amount").focus();
        });

        updateModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            if (!button.classList.contains('update-single-wallet')) {
                // opened from "update all" button, no need to do the user specific stuff
                document.getElementById('update-single-wallet-description').style.display = 'none';
                document.getElementById('update-multiple-wallets-description').style.display = '';
                return;
            }

            if (button.dataset.userId) {
                document.getElementById('modal-user-id').value = button.dataset.userId;
                document.getElementById('modal-user-balance').textContent = button.dataset.userBalance;
                document.getElementById('modal-user-name').textContent = button.dataset.userName;
                document.getElementById('update-single-wallet-description').style.display = '';
                document.getElementById('update-multiple-wallets-description').style.display = 'none';
            }
        });
    </script>
}