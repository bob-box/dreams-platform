@model IEnumerable<Borderland.Dreams.ViewModels.FundingRoundViewModel>

@{
    ViewData["Title"] = "Manage Funding Rounds";
}

<h1>Manage Funding Rounds</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Funding Round</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StartDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EndDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AllocationPerUser)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MaxPercentagePerDream)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TotalFundsAllocated)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.StartDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EndDate)
            </td>
            <td>
                @item.AllocationPerUser.ToString("C")
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MaxPercentagePerDream)%
            </td>
            <td>
                @item.TotalFundsAllocated.ToString("C")
            </td>
            <td>
                @if (item.HasPassed(appTime))
                {
                    @* Past funding round *@
                    <span class="text-muted">Passed</span>
                }
                else if (item.IsActive(appTime))
                {
                    @* Active funding round *@
                    <a asp-action="Edit" asp-route-id="@item.ID">Edit</a><text> | </text><span class="text-muted">Active</span>
                }
                else
                {
                    @* Future funding round *@
                    <a asp-action="Edit" asp-route-id="@item.ID">Edit</a><text> | </text><a asp-action="Delete" asp-route-id="@item.ID">Delete</a>
                }
            </td>
        </tr>
}
    </tbody>
</table>