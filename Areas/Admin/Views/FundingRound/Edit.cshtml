@model Borderland.Dreams.ViewModels.FundingRoundViewModel

@{
    ViewData["Title"] = "Edit Funding Round";
    bool isActive = ViewData["IsActive"] as bool? ?? false;
}

<h1>Edit Funding Round</h1>

@if (isActive)
{
    <div class="alert alert-info">This funding round is currently active. Only the end date and max percentage per dream can be changed.</div>
}

<h4>Funding Round</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="All" class="text-danger"></div>
            <input type="hidden" asp-for="ID" />
            <input type="hidden" asp-for="CloudID" />
            <div class="form-group">
                <label asp-for="Title" class="control-label"></label>
                @if (isActive)
                {
                    <input type="hidden" asp-for="Title" />
                    <input asp-for="Title" class="form-control" disabled />
                }
                else
                {
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                }
            </div>
            <div class="form-group">
                <label asp-for="StartDate" class="control-label"></label>
                @if (isActive)
                {
                    <input type="hidden" asp-for="StartDate" />
                    <input asp-for="StartDate" class="form-control" type="datetime-local" disabled />
                }
                else
                {
                    <input asp-for="StartDate" class="form-control" type="datetime-local" />
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                }
            </div>
            <div class="form-group">
                <label asp-for="EndDate" class="control-label"></label>
                <input asp-for="EndDate" class="form-control" type="datetime-local" />
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MaxPercentagePerDream" class="control-label"></label>
                <input asp-for="MaxPercentagePerDream" class="form-control" data-val="false" />
                <span asp-validation-for="MaxPercentagePerDream" class="text-danger"></span>
                <small class="form-text text-muted">Maximum percentage of a user's per-round allocation that can be given to a single dream.</small>
            </div>
            <div class="form-group">
                <label asp-for="AllocationPerUser" class="control-label"></label>
                @if (isActive)
                {
                    <input type="hidden" asp-for="AllocationPerUser" />
                    <input asp-for="AllocationPerUser" class="form-control" data-val="false" disabled />
                }
                else
                {
                    <input asp-for="AllocationPerUser" class="form-control" data-val="false" />
                }
                <small class="form-text text-muted">Amount each user will receive in their wallet when this round starts.</small>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}