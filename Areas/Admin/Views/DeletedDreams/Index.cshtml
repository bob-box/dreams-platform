@model IReadOnlyList<Borderland.Dreams.ViewModels.DreamViewModel>

@{
    ViewData["Title"] = "Deleted Dreams";
}

<h1>Deleted Dreams</h1>

@if (Model.Count == 0)
{
    <p class="text-muted">There are no deleted dreams in this cloud.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Dream</th>
                <th>Dreamers</th>
                <th>Created</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var dream in Model)
            {
                <tr>
                    <td>@dream.Name</td>
                    <td>@string.Join(", ", dream.Dreamers.Select(d => d.Name))</td>
                    <td>@Html.DisplayFor(_ => dream.CreatedAt)</td>
                    <td>@dream.Status</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@dream.ID"
                           asp-route-cloudSlug="@cloudNameResolver.CloudSlug">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
