@model Borderland.Dreams.ViewModels.DreamViewModel

@{
    ViewData["Title"] = "Deleted Dream Details";
}

<div class="row align-items-center">
    <div class="col">
        <h1>@Model.Name</h1>
    </div>
    <div class="col-auto">
        <form method="post" asp-action="Restore" asp-route-id="@Model.ID"
              asp-route-cloudSlug="@cloudNameResolver.CloudSlug" class="d-inline">
            <button type="submit" class="btn btn-success">Restore dream</button>
        </form>
        <a class="btn btn-secondary" asp-action="Index" asp-route-cloudSlug="@cloudNameResolver.CloudSlug">Back to list</a>
    </div>
</div>

<hr />
<dl class="row">
    <dt class="col-sm-2">Description</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.Description)</dd>

    <dt class="col-sm-2">Created</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.CreatedAt)</dd>

    <dt class="col-sm-2">Status</dt>
    <dd class="col-sm-10">@Model.Status</dd>

    <dt class="col-sm-2">Dreamers</dt>
    <dd class="col-sm-10">@string.Join(", ", Model.Dreamers.Select(d => d.Name))</dd>

    @if (Model.Tags.Count > 0)
    {
        <dt class="col-sm-2">Tags</dt>
        <dd class="col-sm-10">
            @foreach (var tag in Model.Tags)
            {
                <span class="badge bg-secondary me-1">@tag.Title</span>
            }
        </dd>
    }

    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.RequestedBudgetItems)</dt>
    <dd class="col-sm-10">
        <ul>
            @foreach (var item in Model.RequestedBudgetItems)
            {
                <li>@item.Name: @item.MinAmount?.ToString("C")@(item.MaxAmount is null ? "" : $" - {item.MaxAmount:C}")</li>
            }
        </ul>
        Total (min): @Html.DisplayFor(model => model.TotalRequestedBudget)
    </dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.ExistingBudgetItems)</dt>
    <dd class="col-sm-10">
        <ul>
            @foreach (var item in Model.ExistingBudgetItems)
            {
                <li>@item.Name: @item.MinAmount?.ToString("C")@(item.MaxAmount is null ? "" : $" - {item.MaxAmount:C}")</li>
            }
        </ul>
        Total (min): @Html.DisplayFor(model => model.TotalExistingBudget)
    </dd>

    <dt class="col-sm-2">Funding</dt>
    <dd class="col-sm-10">
        <ul>
            @foreach (var fundGroup in Model.Funds.GroupBy(f => f.UserID))
            {
                <li>@fundGroup.First().User.Name: @fundGroup.Sum(f => f.Amount).ToString("C")</li>
            }
        </ul>
        Total funded: @Model.Funds.Sum(f => f.Amount).ToString("C")
    </dd>
</dl>
