@model IEnumerable<Borderland.Dreams.Models.EmailCampaign>

@{
    ViewData["Title"] = "Email Campaigns";
}

<h1>Email campaigns</h1>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Create email campaign</a>
</p>

@if (!Model.Any())
{
    <p class="text-muted">No email campaigns have been created.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Subject</th>
                <th>Audience</th>
                <th>Status</th>
                <th>Scheduled</th>
                <th>Sent</th>
                <th>Recipients</th>
                <th>Error</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var campaign in Model)
        {
            <tr>
                <td>@campaign.Subject</td>
                <td>@campaign.Audience @if (campaign.DreamStatus.HasValue) { <span>(@campaign.DreamStatus)</span> }</td>
                <td>@campaign.Status</td>
                <td>@(campaign.ScheduledAtUtc?.ToString("u") ?? "Now")</td>
                <td>@campaign.SentAtUtc?.ToString("u")</td>
                <td>@campaign.RecipientCount</td>
                <td>@campaign.Error</td>
                <td class="text-end">
                    @if (campaign.Status == Borderland.Dreams.Enums.EmailCampaignStatus.Scheduled &&
                         campaign.ScheduledAtUtc > appTime.UtcNow)
                    {
                        <a asp-action="Edit" asp-route-id="@campaign.ID" class="btn btn-sm btn-outline-primary">Edit</a>
                        <form asp-action="Cancel" asp-route-id="@campaign.ID" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                    onclick="return confirm('Cancel this scheduled email campaign?');">Cancel</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
