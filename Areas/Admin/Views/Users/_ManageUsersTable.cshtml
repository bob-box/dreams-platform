@model IEnumerable<Borderland.Dreams.ViewModels.ManageUsersViewModel>

<tbody>
@foreach (var user in Model)
{
    <tr>
        <td>@user.FullName</td>
        <td>@user.UserName</td>
        <td>@user.Email</td>
        <td>@user.Role</td>
        <td>
            @(user.Wallet != null ? user.Wallet.Balance.ToString("F2") : "no wallet for this cloud")
        </td>
        <td class="text-end">
            <button class="btn btn-outline-primary update-single-wallet" data-bs-toggle="modal" data-bs-target="#update-wallet-modal"
                data-user-id="@user.UserId"
                data-user-fullname="@user.FullName"
                data-user-username="@user.UserName"
                data-user-balance="@user.Wallet?.Balance"
            >Update wallet</button>
        </td>
    </tr>
}
</tbody>