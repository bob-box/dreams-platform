@model Borderland.Dreams.ViewModels.CloudViewModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Cloud</h4>
<hr />
<div class="row">
    <div class="col-lg-6">
        <form asp-action="Create">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Slug" class="control-label">URL slug</label>
                <input asp-for="Slug" class="form-control" readonly />
                <small class="form-text text-muted">Generated from the cloud name and fixed after creation.</small>
            </div>
            <div class="form-group">
                <label asp-for="TotalFundsAvailable" class="control-label"></label>
                <input asp-for="TotalFundsAvailable" class="form-control" />
                <span asp-validation-for="TotalFundsAvailable" class="text-danger"></span>
            </div>
            <hr />
            <h5>Dream Creation Period</h5>
            <div class="row">
                <description asp-for="DreamCreatePeriodStart"></description>
                <div class="col-6">
                    <div class="form-group"><label asp-for="DreamCreatePeriodStart" class="control-label"></label>
                    <input asp-for="DreamCreatePeriodStart" class="form-control" />
                    <span asp-validation-for="DreamCreatePeriodStart" class="text-danger"></span>
                </div>
                </div>
                <div class="col-6">
                    <div class="form-group"><label asp-for="DreamCreatePeriodEnd" class="control-label"></label>
                    <input asp-for="DreamCreatePeriodEnd" class="form-control" />
                    <span asp-validation-for="DreamCreatePeriodEnd" class="text-danger"></span>
                </div>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="DreamEditDeadline" class="control-label"></label>
                <description asp-for="DreamEditDeadline"></description>
                <input asp-for="DreamEditDeadline" class="form-control" />
                <span asp-validation-for="DreamEditDeadline" class="text-danger"></span>
            </div>
            <hr />
            <h5>Dream welcome email</h5>
            <div class="form-check mb-3">
                <input asp-for="SendDreamWelcomeEmail" class="form-check-input" />
                <label asp-for="SendDreamWelcomeEmail" class="form-check-label"></label>
            </div>
            <div class="form-group mb-3">
                <label asp-for="DreamWelcomeEmailSubject" class="control-label"></label>
                <input asp-for="DreamWelcomeEmailSubject" class="form-control" />
                <span asp-validation-for="DreamWelcomeEmailSubject" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="DreamWelcomeEmailBody" class="control-label"></label>
                <textarea asp-for="DreamWelcomeEmailBody" class="form-control" rows="6"></textarea>
                <span asp-validation-for="DreamWelcomeEmailBody" class="text-danger"></span>
                <div class="form-text">Use <code>{DreamName}</code> to include the dream's name.</div>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        const cloudNameInput = document.getElementById('Name');
        const cloudSlugInput = document.getElementById('Slug');
        const slugPreviewUrl = '@Url.Action("PreviewSlug", "Cloud", new { area = "Admin" })';
        let previewRequest = 0;

        cloudNameInput.addEventListener('blur', async () => {
            const name = cloudNameInput.value.trim();
            const requestId = ++previewRequest;
            if (!name) {
                cloudSlugInput.value = '';
                return;
            }

            try {
                const response = await fetch(`${slugPreviewUrl}?name=${encodeURIComponent(name)}`);
                if (!response.ok || requestId !== previewRequest) return;

                const result = await response.json();
                if (requestId === previewRequest) {
                    cloudSlugInput.value = result.slug;
                }
            } catch {
                cloudSlugInput.value = '';
            }
        });
    </script>
}
