@model Borderland.Dreams.ViewModels.AuditLogViewModel

@{
    ViewData["Title"] = "Audit log";
}

<h1>Audit log</h1>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <label for="searchText" class="form-label">Search</label>
        <input id="searchText" name="searchText" value="@Model.SearchText" class="form-control" />
    </div>
    <div class="col-md-2">
        <label for="cloudId" class="form-label">Cloud</label>
        <select id="cloudId" name="cloudId" class="form-select">
            <option value="">All clouds</option>
            @foreach (var cloud in Model.Clouds)
            {
                <option value="@cloud.ID" selected="@(Model.CloudID == cloud.ID)">@cloud.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label for="entityType" class="form-label">Entity</label>
        <select id="entityType" name="entityType" class="form-select">
            <option value="">All entities</option>
            <option value="Dream" selected="@(Model.EntityType == "Dream")">Dream</option>
            <option value="Cloud" selected="@(Model.EntityType == "Cloud")">Cloud</option>
            <option value="Funding round" selected="@(Model.EntityType == "Funding round")">Funding round</option>
        </select>
    </div>
    <div class="col-md-2">
        <label for="action" class="form-label">Action</label>
        <select id="action" name="action" class="form-select">
            <option value="">All actions</option>
            <option value="Created" selected="@(Model.Action == "Created")">Created</option>
            <option value="Updated" selected="@(Model.Action == "Updated")">Updated</option>
            <option value="Deleted" selected="@(Model.Action == "Deleted")">Deleted</option>
            <option value="Restored" selected="@(Model.Action == "Restored")">Restored</option>
        </select>
    </div>
    <div class="col-md-1">
        <label for="from" class="form-label">From</label>
        <input id="from" name="from" type="date" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-md-1">
        <label for="to" class="form-label">To</label>
        <input id="to" name="to" type="date" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-md-1 d-flex align-items-end">
        <button type="submit" class="btn btn-primary">Filter</button>
    </div>
</form>

@if (Model.Entries.Count == 0)
{
    <p class="text-muted">No audit entries match these filters.</p>
}
else
{
    <p class="text-muted">Showing the latest @Model.Entries.Count entries matching the filters (maximum 500).</p>
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>When</th>
                    <th>Who</th>
                    <th>Cloud</th>
                    <th>Entity</th>
                    <th>Action</th>
                    <th>Changes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in Model.Entries)
                {
                    <tr>
                        <td>@entry.CreatedAt.ToLocalTime().ToString()</td>
                        <td>@entry.UserName</td>
                        <td>@entry.CloudName</td>
                        <td>@entry.EntityType: @entry.EntityName</td>
                        <td>@entry.Action</td>
                        <td>
                            @if (entry.Changes.Count > 0)
                            {
                                <details>
                                    <summary>@entry.Changes.Count field(s)</summary>
                                    <ul class="mb-0">
                                        @foreach (var change in entry.Changes)
                                        {
                                            <li>
                                                <strong>@change.Property</strong>:
                                                <code>@(change.OldValue ?? "—")</code>
                                                &rarr;
                                                <code>@(change.NewValue ?? "—")</code>
                                            </li>
                                        }
                                    </ul>
                                </details>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
