@model Borderland.Dreams.ViewModels.TagViewModel

@{
    ViewData["Title"] = "Delete Tag";
}

<h1>Delete Tag</h1>
<h3>Are you sure you want to delete this tag?</h3>
<p class="text-muted">Any dreams tagged with <strong>@Model.Title</strong> will simply have this tag removed.</p>
<hr />
<dl class="row">
    <dt class="col-sm-2">Title</dt>
    <dd class="col-sm-10">@Model.Title</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="ID" />
    <input type="submit" value="Delete" class="btn btn-danger" />
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>
