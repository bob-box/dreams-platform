@model Borderland.Dreams.ViewModels.CloudInfoViewModel

@{
    ViewData["Title"] = "Edit Cloud Info";
}

@section Styles {
    <link rel="stylesheet" href="~/lib/wysi/wysi.min.css" />
}

<form asp-action="EditInfo" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3 d-flex justify-content-between align-items-center">
        <h1 class="mb-0">Edit Info: @cloudNameResolver.CloudName</h1>

        <div class="d-flex gap-1">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Info" class="btn btn-secondary">Cancel</a>
        </div>
    </div>
    <div class="mb-3">
        <textarea asp-for="Content" class="form-control" rows="12"></textarea>
        <span asp-validation-for="Content" class="text-danger"></span>
    </div>
</form>

@section Scripts {
    <script src="~/lib/wysi/wysi.min.js"></script>
    <script>
        Wysi({
            el: '#Content',
            height: 300,
            autoGrow: true,
            autoHide: false,
            tools: [
                'format', '|',
                'bold', 'italic', 'underline', 'strike', '|',
                'ul', 'ol', '|',
                'link', 'image', 'hr', 'quote', '|',
                'removeFormat'
            ]
        });
    </script>
}