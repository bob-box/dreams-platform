@model Borderland.Dreams.ViewModels.CloudFundsViewModel

<div class="card bg-light mb-3">
    <div class="card-body">
        <h5 class="card-title">Cloud wide numbers</h5>
        <div class="row">
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-subtitle">Funds available</h6>
                        <p class="card-text">@Model.TotalFundsAvailable.ToString("F2") SEK</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-subtitle">Funds spent</h6>
                        <p class="card-text">@Model.TotalFundsSpent.ToString("F2") SEK</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-subtitle">Funds remaining</h6>
                        <p class="card-text">@Model.TotalFundsRemaining.ToString("F2") SEK</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>