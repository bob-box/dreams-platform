@model Borderland.Dreams.ViewModels.CloudFundsViewModel

<div class="card bg-light mb-3">
    <div class="card-body">
        <div class="row">
            <div class="col">
                <h5 class="card-title">Funding rounds</h5>
                <ul class="list-group">
                    @foreach (var round in Model.FundingRounds)
                    {
                        var cssClass = round.HasPassed(appTime) ? "disabled" : "";
                        <li class="list-group-item @cssClass">
                            @round.StartDate.ToShortDateString() - @round.EndDate.ToShortDateString()
                            @if (round.IsActive(appTime))
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else if (round.HasPassed(appTime))
                            {
                                <span class="badge bg-secondary">Passed</span>
                            }
                            else
                            {
                                <span class="badge bg-info">Upcoming</span>
                            }
                        </li>
                    }
                </ul>
            </div>
            <div class="col">
                <h5 class="card-title">Cloud funds</h5>
                <div class="row">
                    <div class="col">
                        <div class="card">
                            <div class="card-body">
                                <h6 class="card-subtitle">Funds available</h6>
                                <p class="card-text">@Model.TotalFundsAvailable.ToString("F2") SEK</p>
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card">
                            <div class="card-body">
                                <h6 class="card-subtitle">Funds spent</h6>
                                <p class="card-text">@Model.TotalFundsSpent.ToString("F2") SEK</p>
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card">
                            <div class="card-body">
                                <h6 class="card-subtitle">Funds remaining</h6>
                                <p class="card-text">@Model.TotalFundsRemaining.ToString("F2") SEK</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="col-3">
                    <h5 class="card-title">Your funds</h5>
                    <div class="row">
                        <div class="col">
                            <div class="card">
                                <div class="card-body">
                                    <h6 class="card-subtitle">Wallet balance</h6>
                                    <p class="card-text">@Model.UserWalletBalance.ToString("F2") SEK</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>