@model Borderland.Dreams.ViewModels.CloudFundsViewModel

<div class="row mb-3">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Total Funds Allocated</h5>
                <p class="card-text h4">@Model.TotalFundsAllocated.ToString("F2") SEK</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Total Funds Left</h5>
                <p class="card-text h4">@Model.TotalFundsLeft.ToString("F2") SEK</p>
            </div>
        </div>
    </div>
</div>
