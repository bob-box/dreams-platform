@model Borderland.Dreams.ViewModels.CloudFundsViewModel

<div class="card bg-light mb-3">
    <div class="card-body">
        <div class="row">
            <div class="col">
                <h5 class="card-title">Dreaming period</h5>
                <ul class="list-group">
                    @if (Model.DreamingPeriodStart.HasValue)
                    {
                        <li class="list-group-item">
                            @Model.DreamingPeriodStart
                            <span class="badge bg-success">Start</span>
                        </li>
                    }
                    @if (Model.DreamingPeriodEnd.HasValue)
                    {
                        <li class="list-group-item">
                            @Model.DreamingPeriodEnd
                            <span class="badge bg-success">End</span>
                        </li>
                    }
                    @if (Model.DreamEditDeadline.HasValue)
                    {
                        <li class="list-group-item">
                            @Model.DreamEditDeadline
                            <span class="badge bg-success">Edit deadline</span>
                        </li>
                    }
                </ul>
            </div>
            <div class="col">
                <h5 class="card-title">Funding rounds</h5>
                <ul class="list-group">
                    @foreach (var round in Model.FundingRounds)
                    {
                        var cssClass = round.HasPassed(appTime) ? "disabled" : "";
                        <li class="list-group-item @cssClass">
                            @round.StartDate - @round.EndDate
                            @if (round.IsActive(appTime))
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else if (round.HasPassed(appTime))
                            {
                                <span class="badge bg-secondary">Passed</span>
                            }
                            else
                            {
                                <span class="badge bg-info">Upcoming</span>
                            }
                        </li>
                    }
                </ul>
            </div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="col-5">
                    <h5 class="card-title">Your funds</h5>
                    <div class="row">
                        <div class="col">
                            <div class="card">
                                <div class="card-body">
                                    <h6 class="card-subtitle">Wallet balance</h6>
                                    <p class="card-text">@Model.UserWalletBalance.ToString("F2") SEK</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>