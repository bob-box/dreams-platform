@model List<Borderland.Dreams.ViewModels.DreamerViewModel>

<ul class="list-unstyled">
    @foreach (var dreamer in Model)
    {
        <li>
            <span class="badge bg-@(dreamer.IsMainDreamer ? "primary" : "secondary")">
                @Html.DisplayFor(model => dreamer.User.FullName)
            </span>
        </li>
    }
</ul>