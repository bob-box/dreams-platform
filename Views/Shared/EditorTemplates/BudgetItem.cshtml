@using HtmlHelpers.BeginCollectionItemCore;

@model Borderland.Dreams.Models.BudgetItem

@{
    bool hasMaxAmount = Model.MaxAmount != null;
}

@using (Html.BeginCollectionItem("BudgetItems"))
{
    <div class="budget-item-container border rounded p-2 mb-2">
        <input type="hidden" asp-for="ID" />
        <input type="hidden" asp-for="DreamID" />
        <div class="row">
            <label asp-for="Name" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="Name" class="form-control" />
            </div>
        </div>
        <div class="row">
            <label asp-for="MinAmount" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <div class="input-group">
                    <input asp-for="MinAmount" class="form-control" type="number" placeholder="Minimum Amount" />
                    <span class="input-group-text">-</span>
                    <input asp-for="MaxAmount" class="form-control" type="number" />
                </div>
            </div>
        </div>
        <div class="row">
            <label asp-for="Type" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-4">
                <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<BudgetItemType>()"></select>
            </div>
            <div class="col-sm-6 text-end">
                <button type="button" class="btn btn-danger btn-remove-item ms-auto" onclick="removeBudgetItem(this)">Delete item</button>
            </div>
        </div>
    </div>
}