<script>
    document.addEventListener("DOMContentLoaded", function () {

        // Add event listener for the "Add Budget Item" button that gets the HTML for a new budget item
        document.getElementById("add-budget-item").addEventListener("click", function () {
            fetch('@Url.Action("NewBudgetItem", "Dream")')
                .then(response => response.text())
                .then(html => {
                    const container = document.getElementById('budget-items');
                    container.insertAdjacentHTML('beforeend', html);
                });
        });
    });

    // Called by the BudgetItem Editor Template
    function showMaxAmountField(btn) {
        const itemDiv = btn.closest('.budget-item');
        toggleDisplay(itemDiv.querySelector('.max-amount-group'));
        toggleDisplay(btn.querySelectorAll('span')[0]);
        toggleDisplay(btn.querySelectorAll('span')[1]);
    }
    
    function toggleDisplay(element) {
        if (element.style.display === 'none') {
            element.style.display = '';
        } else {
            element.style.display = 'none';
            let input = element.querySelector('input');
            if (input) {
                input.value = '';
            }
        }
    }

    // Called by the BudgetItem Editor Template
    function removeBudgetItem(btn) {
        const itemDiv = btn.closest('.budget-item');
        itemDiv.remove();
    }
</script>