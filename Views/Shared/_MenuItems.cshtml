@using Microsoft.Identity.Client
@{
    var cloudName = cloudNameResolver.CloudName;
    var isWithinACloud = !string.IsNullOrWhiteSpace(cloudName);
}
@functions {
    public string GetActiveClass(string controllerName)
    {
        return ViewContext.RouteData.Values["controller"]?.ToString() == controllerName ? "active" : "";
    }
}

<nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
    <div class="container-fluid">
        <a class="navbar-brand" asp-controller="Home" asp-action="" asp-route-cloudName="">Start</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
            <ul class="navbar-nav flex-grow-1">
                @if (isWithinACloud)
                {
                    <li class="nav-item">
                        <a class="nav-link text-dark @(GetActiveClass("Dream"))" asp-area="" asp-controller="Dream" asp-action="Index" asp-route-cloudName="@cloudNameResolver.CloudName">Dreams</a>
                    </li>
                }
            </ul>
            @if (isWithinACloud && User.IsInRole(Constants.AdminRole))
            {
                <ul class="navbar-nav">
                    <li class="nav-item ms-sm-auto dropdown">
                        <a class="nav-link text-dark dropdown-toggle" data-bs-toggle="dropdown" href="#">Admin Control Panel</a>
                        <ul class="dropdown-menu">
                            @if (isWithinACloud)
                            {
                                <li>
                                    <a class="dropdown-item" asp-area="Admin" asp-controller="Manage" asp-action="EditCloud" asp-route-id="@cloudNameResolver.CloudID">Edit Cloud</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="Admin" asp-controller="Manage" asp-action="UsersInCloud">Manage Users</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="Admin" asp-controller="Tag" asp-action="Index">Manage Tags</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="Admin" asp-controller="FundingRound" asp-action="Index">Manage Funding Rounds</a>
                                </li>
                            }
                        </ul>
                    </li>
                </ul>
            }
            <partial name="_LoginPartial" />
        </div>
    </div>
</nav>