@model IEnumerable<Borderland.Dreams.ViewModels.ManageUsersViewModel>
@{
    ViewData["Title"] = "Manage Users";
}

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>UserName</th>
            <th>Email</th>
            <th>Role</th>
            <th>Wallet Balance</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var user in Model)
    {
        <tr>
            <td>@user.FullName</td>
            <td>@user.UserName</td>
            <td>@user.Email</td>
            <td>@user.Role</td>
            <td>@(user.Wallet != null ? user.Wallet.Balance.ToString("F2") : "no wallet for this cloud")</td>
        </tr>
    }
    </tbody>
</table>