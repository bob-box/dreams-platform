@model IReadOnlyList<Borderland.Dreams.ViewModels.CommentViewModel>

@if (Model.Count == 0)
{
    <p>No comments yet.</p>
}
else
{
    <ol class="list-unstyled">
        @foreach (var comment in Model)
        {
            <li id="comment-@comment.Id" class="border-bottom py-3">
                <p class="mb-1">
                    <strong>@comment.AuthorName</strong>
                    <time>@comment.CreatedAt.ToString("yyyy-MM-dd HH:mm")</time>
                </p>
                <div class="comment-body">@comment.Body</div>
            </li>
        }
    </ol>
}
