@model Borderland.Dreams.Models.Dream

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Dream</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ID" />
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
            <div id="budget-items">
                @if (Model.BudgetItems != null)
                {
                    @Html.EditorFor(model => model.BudgetItems)
                }
            </div>
            <button type="button" class="btn btn-secondary mt-2" id="add-budget-item">Add Budget Item new</button>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
        await Html.RenderPartialAsync("_EditBudgetItemsScript");
    }
}
