@model Borderland.Dreams.Models.Dream

@{
    ViewData["Title"] = "Edit";
}

<div class="row">
    <div class="col-md-6">
        <h1>Edit dream</h1>
    </div>
    <div class="col-md-6 text-end mt-2">
        <button type="button" class="btn btn-primary" onclick="document.getElementById('form-edit-dream').submit()">Save</button>
        <a class="btn btn-secondary" asp-action="Index">Cancel</a>
    </div>
</div>
<div asp-validation-summary="All" class="text-danger"></div>

<hr />

<form asp-action="Edit" id="form-edit-dream">
    <div class="row">
        <div class="col-md-4">
            <h4>Dream</h4>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ID" />
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <hr />
            <h4>Dreamers</h4>
            <table class="table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Type</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dreamer in Model.Dreamers)
                    {
                        <tr>
                            <td>@dreamer.User.FullName</td>
                            <td>@(dreamer.IsMainDreamer ? "Main Dreamer" : "Co-Dreamer")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="col-md-8">
            <h4>Budget Items</h4>
            <div id="budget-items">
                @if (Model.BudgetItems != null)
                {
                    @Html.EditorFor(model => model.BudgetItems)
                }
            </div>
            <button type="button" class="btn btn-outline-secondary mt-2" id="add-budget-item" onclick="addBudgetItem()">&#65291; Add new item</button>
        </div>
</form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script type="text/javascript">
        // "Add Budget Item" button that gets the HTML for a new budget item
        function addBudgetItem() {
            fetch('@Url.Action("NewBudgetItem", "Dream")')
                .then(response => response.text())
                .then(html => {
                    const container = document.getElementById('budget-items');
                    container.insertAdjacentHTML('beforeend', html);
                });
        });

        // Called by the BudgetItem Editor Template
        function removeBudgetItem(btn) {
            const container = btn.closest('.budget-item-container')
            const itemDiv = container.querySelector('.budget-item');
            const isDeletedInput = container.querySelector('.is-deleted');

            isDeletedInput.checked = true;
            itemDiv.remove();
        }
    </script>
}