@model Borderland.Dreams.Models.Dream

@{
    ViewData["Title"] = "Edit";
}

<div class="row">
    <div class="col-md-6">
        <h1>Edit dream</h1>
    </div>
    <div class="col-md-6 text-end mt-2">
        <button type="submit" class="btn btn-primary" form="form-edit-dream">Save</button>
        <a class="btn btn-secondary" asp-action="Index">Cancel</a>
    </div>
</div>

<hr />

<form asp-action="Edit" id="form-edit-dream">
    <div class="row">
        <div class="col-md-4">
            <h4>Dream</h4>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ID" />
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <hr />
            <h4>Dreamers</h4>
            <table class="table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Type</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dreamer in Model.Dreamers)
                    {
                        <tr>
                            <td>@dreamer.User.FullName</td>
                            <td>@(dreamer.IsMainDreamer ? "Main Dreamer" : "Co-Dreamer")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="col-md-8">
            <h4>Budget Items</h4>
            <div id="budget-items">
                @if (Model.BudgetItems != null)
                {
                    @Html.EditorFor(model => model.BudgetItems)
                }
            </div>
            <button type="button" class="btn btn-outline-secondary mt-2" id="add-budget-item">&#65291; Add new item</button>
        </div>
</form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
        await Html.RenderPartialAsync("_EditBudgetItemsScript");
    }
}