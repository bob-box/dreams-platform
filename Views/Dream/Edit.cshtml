@model Borderland.Dreams.ViewModels.DreamViewModel
@using Borderland.Dreams.Extensions
@{
    ViewData["Title"] = "Edit";
}

<div class="row">
    <div class="col-md-6">
        <h1>Edit dream</h1>
    </div>
    <div class="col-md-6 text-end mt-2">
        <button type="button" class="btn btn-primary" onclick="document.getElementById('form-edit-dream').submit()">Save</button>
        <a class="btn btn-secondary" asp-controller="Cloud" asp-action="Index">Cancel</a>
    </div>
</div>
<div asp-validation-summary="All" class="text-danger"></div>

<hr />

<form asp-action="Edit" id="form-edit-dream">
    <div class="row">
        <div class="col-md-4">
            <h4>Dream</h4>
            <input type="hidden" asp-for="ID" />
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            @{
                var availableTags = ViewBag.AvailableTags as IEnumerable<Borderland.Dreams.Models.Tag>;
                var tagOptions = SelectListHelper.GetTagOptions(availableTags, Model.SelectedTagIds);
            }
            <partial name="~/Views/Shared/_TagOptions.cshtml" model="tagOptions" />
            <hr />
            <h4>Dreamers</h4>
            <table class="table dreamers-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Type</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @Html.EditorFor(model => model.Dreamers, "DreamerTableRow")
                </tbody>
            </table>
            @if (_authorizationService.AuthorizeAsync(User, Model, Operations.EditDreamers).Result.Succeeded)
            {
                <button type="button" class="btn btn-outline-secondary mt-2" data-bs-toggle="modal" data-bs-target="#add-dreamer-modal">
                    &#65291; Add dreamer
                </button>
            }
        </div>
        <div class="col-md-8">
            <h4>Budget Items</h4>
            <div id="budget-items">
                @if (Model.BudgetItems != null)
                {
                    @Html.EditorFor(model => model.BudgetItems)
                }
            </div>
            <button type="button" class="btn btn-outline-secondary mt-2" id="add-budget-item" onclick="addBudgetItem()">&#65291; Add new item</button>
        </div>
</form>

<partial name="_AddDreamerModal" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script type="text/javascript">
        // "Add Budget Item" button that gets the HTML for a new budget item
        function addBudgetItem() {
            fetch('@Url.Action("NewBudgetItem", "Dream")')
                .then(response => response.text())
                .then(html => {
                    const container = document.getElementById('budget-items');
                    container.insertAdjacentHTML('beforeend', html);
                });
        }

        // Called by the BudgetItem Editor Template
        function removeBudgetItem(btn) {
            const container = btn.closest('.budget-item-container')
            container.remove();
        }

        async function addDreamer() {
            const email = document.getElementById("dreamer-email").value;
            if (!email) {
                return;
            }
            try {

                let response = await fetch('@Url.Action("FindDreamer", "Dream")', {
                    method: 'POST',
                    body: JSON.stringify({ dreamID: @Model.ID, email: email }),
                    headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/json'
                    },
                })
                if (!response.ok) {
                    const errorText = JSON.parse(await response.text());
                    throw new Error(errorText);
                }

                const html = await response.text();
                // Append the new dreamer row to the table
                const tbody = document.querySelector("table.dreamers-table tbody");
                tbody.insertAdjacentHTML('beforeend', html);
                // Close the modal
                const addDreamerModalEl = document.getElementById('add-dreamer-modal');
                const addDreamerModal = bootstrap.Modal.getInstance(addDreamerModalEl);
                addDreamerModal.hide();
                // Clear the input field
                document.getElementById("dreamer-email").value = '';
            } catch (error) {
                document.getElementById("dreamer-email-validation").innerText = error.message;
            }
        }

        $("#add-dreamer-modal").on("shown.bs.modal", function () {
            document.getElementById("dreamer-email").focus();
        });
        $("#add-dreamer-modal").on("hidden.bs.modal", function () {
            document.getElementById("dreamer-email-validation").innerText = '';
        });

        // Called from the DreamerSingle Editor Template
        async function removeDreamer(btn) {
            btn.closest('tr').remove();
        }
    </script>
}