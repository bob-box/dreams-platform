@model Borderland.Dreams.ViewModels.DreamFilterViewModel

@{
    ViewData["Title"] = "Dreams List";
    bool showJoinCloudButton = (ViewData["showJoinCloudButton"] as bool?) ?? false;
    bool hasActiveFilters = !string.IsNullOrEmpty(Model.SearchText) || Model.StatusFilter.HasValue || Model.TagFilter.HasValue;
}

<h1>@cloudNameResolver.CloudName - Dreams List</h1>
<cache expires-after="@TimeSpan.FromSeconds(60)">
    <vc:cloud-funds />
</cache>
@if (showJoinCloudButton)
{
    <p>
        <form asp-action="Join" asp-controller="Cloud" method="post">
            <input type="hidden" name="id" value="@cloudNameResolver.CloudID" />
            <button type="submit">Join Cloud</button>
        </form>
    </p>
}
else
{
    <p>
        <a asp-action="Create">Create New Dream</a>
    </p>
}

<form method="get" asp-action="Index">
    <div class="row g-2 mb-3 align-items-end">
        <div class="col-md-4">
            <label asp-for="SearchText" class="form-label">Search</label>
            <input asp-for="SearchText" class="form-control" placeholder="Search by title or description" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary">Filter</button>
            <button type="button"
                    class="btn btn-outline-secondary"
                    onclick="location.href='@Url.Action("Index", "Dream")'"
                    disabled="@(hasActiveFilters ? null : "disabled")">
                Clear filters
            </button>
        </div>
        <div class="col-md-2">
            <label asp-for="StatusFilter" class="form-label">Status</label>
            <select asp-for="StatusFilter" class="form-select" onchange="this.form.submit()">
                <option value="">All statuses</option>
                @foreach (var status in Enum.GetValues<Borderland.Dreams.Enums.DreamStatus>())
                {
                    <option value="@status">@status</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label asp-for="TagFilter" class="form-label">Tag</label>
            <select asp-for="TagFilter" class="form-select" onchange="this.form.submit()">
                <option value="">All tags</option>
                @foreach (var tag in Model.AvailableTags)
                {
                    <option value="@tag.ID">@tag.Title</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label asp-for="SortOrder" class="form-label">Sort by</label>
            <select asp-for="SortOrder" asp-items="Html.GetEnumSelectList<Borderland.Dreams.Enums.DreamSortOrder>()" class="form-select" onchange="this.form.submit()"></select>
        </div>
        
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Dreams[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Dreams[0].Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Dreams[0].CreatedDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Dreams[0].Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Dreams[0].RequestedBudgetItems) (min)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Dreams[0].TotalReceivedFunds)
            </th>
            <th>
                By dreamer
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Dreams)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Description)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CreatedDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Status)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TotalRequestedBudget)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TotalReceivedFunds)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Dreamers.Single(d => d.IsMainDreamer).Name)
                </td>
                <td>
                    @if (_authorizationService.AuthorizeAsync(User, item.Dreamers, Operations.Update).Result.Succeeded)
                    {
                        <a asp-action="Edit" asp-route-id="@item.ID">Edit</a> <text>|</text>
                    }
                    <a asp-action="Details" asp-route-id="@item.ID">Details</a>
                    @if (_authorizationService.AuthorizeAsync(User, item.Dreamers, Operations.Delete).Result.Succeeded)
                    {
                        <text>|</text> <a asp-action="Delete" asp-route-id="@item.ID">Delete</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
