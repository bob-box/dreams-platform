@model IEnumerable<Borderland.Dreams.ViewModels.DreamViewModel>

@{
    ViewData["Title"] = "Dreams List";
    bool showJoinCloudButton = (ViewData["showJoinCloudButton"] as bool?) ?? false;
}

<h1>@cloudNameResolver.CloudName - Dreams List</h1>
<cache expires-after="@TimeSpan.FromSeconds(60)">
    <vc:cloud-funds />
</cache>
@if (showJoinCloudButton)
{
    <p>
        <form asp-action="Join" asp-controller="Cloud" method="post">
            <input type="hidden" name="id" value="@cloudNameResolver.CloudID" />
            <button type="submit">Join Cloud</button>
        </form>
    </p>
} else {
    <p>
        <a asp-action="Create">Create New Dream</a>
    </p>
}
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RequestedBudgetItems) (min)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TotalReceivedFunds)
            </th>
            <th>
                By dreamer
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TotalRequestedBudget)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TotalReceivedFunds)
            <td>
                @Html.DisplayFor(modelItem => item.Dreamers.Single(d => d.IsMainDreamer).Name)
            </td>
            <td>
                @if (_authorizationService.AuthorizeAsync(User, item.Dreamers, Operations.Update).Result.Succeeded)
                {
                    <a asp-action="Edit" asp-route-id="@item.ID">Edit</a> <text>|</text>
                }
                <a asp-action="Details" asp-route-id="@item.ID">Details</a>
                @if (_authorizationService.AuthorizeAsync(User, item.Dreamers, Operations.Delete).Result.Succeeded)
                {
                   <text>|</text> <a asp-action="Delete" asp-route-id="@item.ID">Delete</a>
                }
            </td>
        </tr>
}
    </tbody>
</table>
