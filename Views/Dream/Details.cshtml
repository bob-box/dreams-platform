@using Microsoft.AspNetCore.Razor.Language
@model Borderland.Dreams.ViewModels.DreamViewModel

@{
    ViewData["Title"] = "Details";
}

<div class="row">
    <div class="col-md-6">
        <h1>@Model.Name</h1>
    </div>
    <div class="col-md-6 text-end mt-2">
        @if (_authorizationService.AuthorizeAsync(User, Model, Operations.Update).Result.Succeeded)
        {
            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.ID">Edit</a>
        }
        @if (_authorizationService.AuthorizeAsync(User, Model, Operations.Delete).Result.Succeeded)
        {
            <a class="btn btn-danger" asp-action="Delete" asp-route-id="@Model.ID">Delete</a>
        }
        <a class="btn btn-secondary" asp-action="Index">Cancel</a>
    </div>
</div>

<hr />
<div>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CreatedDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CreatedDate)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.RequestedBudgetItems)
        </dt>
        <dd class="col-sm-10">
            <ul>
            @foreach (var item in Model.RequestedBudgetItems)
            {
                <li>
                @item.Name:
                @if (item.MaxAmount != null)
                {
                    @($"{item.MinAmount:C} - {item.MaxAmount.Value:C}")
                }
                else
                {
                    @item.MinAmount.ToString("C")
                }
                </li>
            }
            </ul>
            Total (min): @Html.DisplayFor(model => model.TotalRequestedBudget)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ExistingBudgetItems)
        </dt>
        <dd class="col-sm-10">
            <ul>
            @foreach (var item in Model.ExistingBudgetItems)
            {
                <li>
                @item.Name:
                @if (item.MaxAmount != null)
                {
                    @($"{item.MinAmount:C} - {item.MaxAmount.Value:C}")
                }
                else
                {
                    @item.MinAmount.ToString("C")
                }
                </li>
            }
            </ul>
            Total (min): @Html.DisplayFor(model => model.TotalExistingBudget)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Dreamers)
        </dt>
        <dd class="col-sm-10">
            @foreach (var dreamer in Model.Dreamers)
            {
                <span class="badge bg-primary">
                    @Html.DisplayFor(model => dreamer.User.UserName) - @(dreamer.IsMainDreamer ? "Main Dreamer" : "Co-Dreamer")
                </span>
            }
        </dd>
    </dl>
</div>