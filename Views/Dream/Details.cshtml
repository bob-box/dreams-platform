@using Microsoft.AspNetCore.Razor.Language
@model Borderland.Dreams.ViewModels.DreamViewModel

@{
    ViewData["Title"] = "Details";
}

<div class="row">
    <div class="col-md-6">
        <h1>@Model.Name</h1>
    </div>
    <div class="col-md-6 text-end mt-2">
        @if (User.Identity?.IsAuthenticated == true)
        {
            @if (_authorizationService.AuthorizeAsync(User, Model, Operations.Update).Result.Succeeded)
            {
                <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.ID">Edit</a>
            }
            @if (_authorizationService.AuthorizeAsync(User, Model, Operations.Delete).Result.Succeeded)
            {
                <a class="btn btn-danger" asp-action="Delete" asp-route-id="@Model.ID">Delete</a>
            }
        }
        <a class="btn btn-secondary" asp-action="Index">Back to list</a>
    </div>
</div>

<hr />
<div class="row">
    <div class="col-9">
        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Description)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Description)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.CreatedAt)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.CreatedAt)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Status)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Status)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.RequestedBudgetItems)
            </dt>
            <dd class="col-sm-10">
                <ul>
                    @foreach (var item in Model.RequestedBudgetItems)
                    {
                        <li>
                            @item.Name:
                            @if (item.MaxAmount != null)
                            {
                                @($"{item.MinAmount:C} - {item.MaxAmount.Value:C}")
                            }
                            else
                            {
                                @item.MinAmount.Value.ToString("C")
                            }
                        </li>
                    }
                </ul>
                Total (min): @Html.DisplayFor(model => model.TotalRequestedBudget)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.ExistingBudgetItems)
            </dt>
            <dd class="col-sm-10">
                <ul>
                    @foreach (var item in Model.ExistingBudgetItems)
                    {
                        <li>
                            @item.Name:
                            @if (item.MaxAmount != null)
                            {
                                @($"{item.MinAmount:C} - {item.MaxAmount.Value:C}")
                            }
                            else
                            {
                                @item.MinAmount.Value.ToString("C")
                            }
                        </li>
                    }
                </ul>
                Total (min): @Html.DisplayFor(model => model.TotalExistingBudget)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Dreamers)
            </dt>
            <dd class="col-sm-10">
                @Html.EditorFor(model => model.Dreamers, "DreamerBadgeList")
            </dd>
            @if (Model.Tags.Any())
            {
                <dt class="col-sm-2">Tags</dt>
                <dd class="col-sm-10">
                    @foreach (var tag in Model.Tags)
                    {
                        <span class="badge bg-secondary me-1">@tag.Title</span>
                    }
                </dd>
            }
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Funds)
            </dt>
            <dd class="col-sm-10">
                <ul>
                    @foreach (var fundGroup in Model.Funds.GroupBy(f => f.UserID))
                    {
                        <li>
                            @fundGroup.First().User.Name: @fundGroup.Sum(f => f.Amount).ToString("C")
                        </li>
                    }
                </ul>
                Total funded: @Model.Funds.Sum(f => f.Amount).ToString("C")
            </dd>
        </dl>
    </div>

    <div class="col-3">
        <vc:active-funding-round dream-id="@Model.ID" />
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('fundDreamButton')?.addEventListener('click', function () {
            loadFundingModal(@Model.ID);
        });
        var url = '@Url.Action("GetFundingModal", "Dream", new { dreamId = Model.ID })';
        function loadFundingModal(dreamId) {
            fetch(url, {
                method: 'GET',
            })
                .then(response => response.text())
                .then(html => {
                    document.getElementById('modalContainer').innerHTML = html;
                    // Show the modal
                    var modal = new bootstrap.Modal(document.getElementById('fundDreamModal'));
                    modal.show();
                })
                .catch(error => {
                    console.error('Error loading modal:', error);
                    alert('Error loading funding modal. Please try again.');
                });
        }

        // Reset form when modal is closed - using event delegation since modal is loaded dynamically
        document.addEventListener('hidden.bs.modal', function (event) {
            if (event.target.id === 'fundDreamModal') {
                var form = document.getElementById('fundDreamForm');
                if (form) {
                    form.reset();
                }
            }
        });
    </script>
}