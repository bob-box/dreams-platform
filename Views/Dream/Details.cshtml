@model Borderland.Dreams.Models.Dream

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Dream</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CreatedDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CreatedDate)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.BudgetItems)
        </dt>
        <dd class="col-sm-10">
            <ul>
            @foreach (var item in Model.BudgetItems)
            {
                <li>
                @item.Name:
                @if (item.MaxAmount != null)
                {
                    @($"{item.MinAmount:C} - {item.MaxAmount.Value:C}")
                }
                else
                {
                    @item.MinAmount.ToString("C")
                }
                </li>
            }
            </ul>

            @{
            var sumOfBudget = Model.BudgetItems.Sum(b => b.MinAmount).ToString("C");
            }
            Total (min): @Html.DisplayFor(model => sumOfBudget)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Dreamers)
        </dt>
        <dd class="col-sm-10">
            @foreach (var dreamer in Model.Dreamers)
            {
                <span class="badge bg-primary">
                    @Html.DisplayFor(model => dreamer.User.UserName) - @(dreamer.IsMainDreamer ? "Main Dreamer" : "Co-Dreamer")
                </span>
            }
        </dd>
    </dl>
</div>
<div>
    @if (_authorizationService.AuthorizeAsync(User, Model, DreamOperations.Update).Result.Succeeded)
    {
        <a asp-action="Edit" asp-route-id="@Model.ID">Edit</a> <text>|</text>
    }
    @if (_authorizationService.AuthorizeAsync(User, Model, DreamOperations.Delete).Result.Succeeded)
    {
        <a asp-action="Delete" asp-route-id="@Model.ID">Delete</a> <text>|</text> 
    }
    <a asp-action="Index">Back to List</a>
</div>
