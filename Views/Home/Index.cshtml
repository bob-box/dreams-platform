@model IEnumerable<Borderland.Dreams.ViewModels.CloudViewModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Clouds List</h1>

@if(User.IsInRole(Constants.AdminRole))
{
    <p>
        <a asp-area="Admin" asp-controller="Cloud" asp-action="Create" class="btn btn-primary">Create New Cloud</a>
    </p>
}
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TotalFundsAvailable)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Dreams)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CreatedAt)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TotalFundsAvailable)
                </td>
                <td>
                    @(item.Dreams.Where(x => x.IsVisibleToPublic())?.Count() ?? 0)
                </td>
                <td>
                    <a asp-controller="Cloud" asp-action="Index" asp-route-cloudSlug="@item.Slug">Go to Cloud</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@foreach (var item in Model)
{
    @* Cloud shaped pictures of the clouds? *@
